# FRED (Federal Reserve Economic Data) — clave gratuita:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# TwelveData — clave gratuita, usada SOLO para el histórico de precio del
# backtesting (Fase 3), no para ejecución en vivo: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# MetaTrader5 — credenciales de tu cuenta de broker (usa una cuenta DEMO para empezar).
# Si tu terminal MT5 ya está abierta y logueada, puedes dejar estas 3 vacías.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Ruta a terminal64.exe si tu instalación de MT5 no está en la ubicación por defecto (opcional)
MT5_TERMINAL_PATH=

# Nombre exacto del símbolo de oro en tu broker. Varía por broker: "XAUUSD",
# "XAUUSD!", "XAUUSD.micro!", "GOLD", etc. Corre check_price_ingestion.py si
# no estás seguro (te lista los símbolos disponibles que contienen XAU/GOLD).
MT5_SYMBOL=XAUUSD
